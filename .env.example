# =============================================================
# Bu FAQAT namuna fayl. Haqiqiy kalitlarni bu yerga YOZMANG!
#
# Lokal ishlash uchun:  bu faylni `.env.local` nomi bilan nusxalang
#                       va qiymatlarni o'sha yerga yozing.
# Vercel uchun:         Project -> Settings -> Environment Variables
#                       bo'limiga qo'lda kiritiladi (fayl yuklanmaydi).
#
# `.env` va `.env.local` .gitignore'da - GitHub'ga tushmaydi.
# =============================================================

# --- Telegram bot (aloqa formasi shu botga xabar yuboradi) ---
# @BotFather -> /newbot -> token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Sizning shaxsiy chat ID yoki kanal ID.
# Olish uchun: botingizga /start yozing, keyin brauzerda oching:
# https://api.telegram.org/bot<TOKEN>/getUpdates  -> result[0].message.chat.id
TELEGRAM_CHAT_ID=your_chat_id_or_channel_id_here

# --- AI chat (bosh sahifadagi chat oynasi) ---
AI_API_KEY=your_ai_provider_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
